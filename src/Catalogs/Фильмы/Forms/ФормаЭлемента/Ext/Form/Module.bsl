
&НаКлиенте
Процедура ПередЗаписью(Отказ)
	
	ЕстьДубли = ПоискДублей();
	
	Если ЕстьДубли Тогда 
		ПоказатьОповещениеПользователя("",,"Найдено похожее название");
		
		Ответ = Вопрос("Найдено похожее название. Вы хотите продолжить запись?",РежимДиалогаВопрос.ДаНет);
        Если Ответ = КодВозвратаДиалога.Нет Тогда
		   	 Отказ = Истина;
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры


&НаСервере
Функция ПоискДублей()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Фильмы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Фильмы КАК Фильмы
		|ГДЕ
		|	Фильмы.Наименование = &Наименование
		|	И Фильмы.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Наименование", Объект.Наименование);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ОценкаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.Оценка) Тогда
		Если Объект.Оценка > 10 Тогда
			Объект.Оценка = 10;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры
